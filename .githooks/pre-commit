#!/usr/bin/env bash
# Pirmas tikrinimas yra KANONAS.md. DONE GATE yra žemiau ir jo neapeina.
set -uo pipefail

KANON="/opt/efm/vault/gamyba/efm-go/tools/efm_kanonas_hook.py"
GATE="/opt/efm/vault/gamyba/efm-go/tools/efm_done_gate.py"

echo ""
echo "============================================================"
echo " KANONAS — pirmas hukas, aukščiau DONE GATE"
echo "============================================================"

if [ ! -f "$KANON" ]; then
    echo "  FAIL: nėra kanono huko: $KANON"
    echo "  Sutvarkyk: kanono hukas privalo būti vietoje."
    exit 1
fi

python3 "$KANON" --repo "$(git rev-parse --show-toplevel)"
if [ "$?" != "0" ]; then
    echo ""
    echo " COMMIT BLOKUOTAS. Darbas neatitinka KANONAS.md."
    echo " Sutvarkyk darbą pagal kanoną. Tada komituok iš naujo."
    echo " --no-verify naudoti draudžiama."
    exit 1
fi

if [ ! -f "$GATE" ]; then
    echo "  FAIL: nėra DONE GATE: $GATE"
    exit 1
fi

python3 "$GATE" --fast
if [ "$?" != "0" ]; then
    echo ""
    echo " COMMIT BLOKUOTAS — DONE GATE FAIL"
    echo " Gate yra žemiau KANONAS.md. Sutvarkyk darbą ir įrodymus."
    echo " --no-verify naudoti draudžiama."
    exit 1
fi

echo ""
echo " KANONAS ir DONE GATE PASS — commit leidžiamas"
exit 0
