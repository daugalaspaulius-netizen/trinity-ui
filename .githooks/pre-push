#!/usr/bin/env bash
# Push irgi pirma tikrina KANONAS.md. DONE GATE FULL yra žemiau.
set -uo pipefail

KANON="/opt/efm/vault/gamyba/efm-go/tools/efm_kanonas_hook.py"
GATE="/opt/efm/vault/gamyba/efm-go/tools/efm_done_gate.py"

echo "KANONAS — pirmas, prieš push"
python3 "$KANON" --repo "$(git rev-parse --show-toplevel)" --push
if [ "$?" != "0" ]; then
    echo "PUSH BLOKUOTAS. Sutvarkyk darbą pagal KANONAS.md. --no-verify draudžiama."
    exit 1
fi

python3 "$GATE" --full
if [ "$?" != "0" ]; then
    echo "PUSH BLOKUOTAS — DONE GATE FULL FAIL. Sutvarkyk darbą. --no-verify draudžiama."
    exit 1
fi
echo "KANONAS ir DONE GATE FULL PASS"
exit 0
