{
  "manifest": {
    "type": "app",
    "os": "osx",
    "name": "EFM Go.app",
    "outputs": [{ "label": "macos", "path": "EFM Go.app" }],
    "app": {
      "identifier": "com.efmleads.go",
      "embedded_requirements": {},
      "signing_requirements": {
        "signing_args": { "entitlements_path": "SIGNING_METADATA/Entitlements.entitlements" },
        "certificate_type": "developerIDAppDistribution",
        "team_id": ""
      }
    }
  },
  "s3ArtifactLocations": {
    "bucketAccessRole": "${SIGNER_ACCESS_ROLE_ARN}",
    "bucket": "${SIGNING_BUCKET}",
    "inputKey": "${INPUT_KEY}",
    "outputKey": "${OUTPUT_KEY}"
  }
}
