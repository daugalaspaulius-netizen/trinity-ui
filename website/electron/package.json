{
  "name": "efm-go-desktop",
  "version": "0.9.0",
  "description": "EFM Go \u2014 AI agent Windows desktop app",
  "homepage": "https://efmleads.com",
  "desktopName": "efm-go-desktop.desktop",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --require ./test/_preload.cjs --test test/*.test.js mochi/test/*.test.js crew-companion/test/*.test.js",
    "postinstall": "node scripts/patch-nsis-template.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "dist:win:portable": "node scripts/pack-win-portable.js"
  },
  "dependencies": {
    "electron-store": "^8.2.0",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "electron": "^43.2.0",
    "electron-builder": "26.15.3"
  },
  "overrides": {
    "fast-uri": "3.1.7",
    "js-yaml": "4.3.2"
  },
  "build": {
    "appId": "com.efmleads.go",
    "productName": "EFM Go",
    "artifactName": "EFM_Go_Setup_${version}_DEV.${ext}",
    "toolsets": {
      "appimage": "1.0.3"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "icon": "icon.icns",
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "x64ArchFiles": "{**/backend-dist/**,**/backend-dist/**/.*/**}",
      "extendInfo": {
        "CFBundleDisplayName": "EFM Go",
        "NSMicrophoneUsageDescription": "EFM Go uses the microphone for voice input and dictation in chat. Audio is captured only while you hold or toggle the mic button.",
        "NSLocalNetworkUsageDescription": "EFM Go connects to devices on your local network so agent commands can reach your own servers, NAS, containers, and dev machines. Only the addresses a command names are contacted."
      }
    },
    "afterSign": "scripts/notarize.js",
    "linux": {
      "category": "Development",
      "icon": "build/icons",
      "executableName": "efm-go-desktop",
      "maintainer": "EFM Leads <support@efmleads.com>",
      "synopsis": "Persistent AI agent workspace with memory, schedules, and unattended work",
      "syncDesktopName": true,
      "target": [
        "AppImage",
        "deb",
        "rpm"
      ],
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "deb": {
      "packageName": "efm-go",
      "packageCategory": "devel",
      "priority": "optional",
      "publish": [],
      "depends": [
        "libgtk-3-0 | libgtk-3-0t64",
        "libnotify4 | libnotify4t64",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0 | libatspi2.0-0t64",
        "libuuid1",
        "libsecret-1-0",
        "libasound2 | libasound2t64"
      ]
    },
    "rpm": {
      "packageName": "efm-go",
      "packageCategory": "Development/Tools",
      "publish": [],
      "depends": [
        "gtk3",
        "libnotify",
        "nss",
        "libXScrnSaver",
        "libXtst",
        "xdg-utils",
        "at-spi2-core",
        "libuuid",
        "libsecret",
        "alsa-lib"
      ]
    },
    "dmg": {
      "background": "../../packaging/installer-assets/dmg-background.tiff",
      "iconSize": 96,
      "iconTextSize": 13,
      "title": "${productName}",
      "filesystem": "HFS+",
      "contents": [
        {
          "x": 170,
          "y": 246,
          "type": "file"
        },
        {
          "x": 490,
          "y": 246,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "writeUpdateInfo": false
    },
    "files": [
      "main.js",
      "gateway-supervisor.js",
      "runtime/gateway/launch-preflight.js",
      "runtime/gateway/port-holders.js",
      "runtime/gateway/family-takeover.js",
      "runtime/gateway/token-sources.js",
      "runtime/gateway/remote-crew-prompt.js",
      "window-lifecycle.js",
      "runtime/window/chrome.js",
      "runtime/window/prompts.js",
      "runtime/window/session-security.js",
      "runtime/window/linux-captions.js",
      "runtime/window/browser-panels.js",
      "ipc-registrar.js",
      "app-window-error-latch.js",
      "app-menu.js",
      "windows-menu-model.js",
      "windows-titlebar.js",
      "badge.js",
      "native-theme.js",
      "zoom.js",
      "instance-guard.js",
      "context-menu.js",
      "find-bin.js",
      "gateway-env.js",
      "mac-env.js",
      "bundle-integrity.js",
      "data-home.js",
      "auto-update.js",
      "runtime/update/state-reporter.js",
      "runtime/update/managed-lane.js",
      "runtime/update/feed-lane.js",
      "update-logger.js",
      "bundle-location.js",
      "gateway-auth-hint.js",
      "blocking-prompt.js",
      "splash-history.js",
      "startup-timing.js",
      "hide-to-tray.js",
      "html-fullscreen.js",
      "fullscreen-transition-watch.js",
      "gateway-stop.js",
      "gateway-wait.js",
      "sandbox-profile.js",
      "windows-port.js",
      "home-dir.js",
      "local-token.js",
      "local-gateway.js",
      "wsl-detection.js",
      "mochi-session-token.js",
      "window-state.js",
      "linux-frame.js",
      "global-hotkey.js",
      "gateway-liveness.js",
      "gateway-recovery.js",
      "renderer-recovery.js",
      "hang-recovery.js",
      "native-logging.js",
      "crash-collector.js",
      "runtime/crash/ownership.js",
      "runtime/crash/artifact-parsers.js",
      "runtime/crash/candidates.js",
      "runtime/crash/persistence.js",
      "runtime/crash/scan.js",
      "disable-gpu.js",
      "gpu-crash-fallback.js",
      "early-boot-guard.js",
      "memory-watch-log.js",
      "frame-load-log.js",
      "pane-asset-journal.js",
      "cage-trace.js",
      "pyspy-dump.js",
      "perf-metrics.js",
      "host-config.js",
      "open-path.js",
      "store-rename.js",
      "upgrade-cache.js",
      "remote-token.js",
      "remote-crew-setup.js",
      "tunnel-keeper.js",
      "token-acquire.js",
      "token-retry.js",
      "capture-trust.js",
      "display-media.js",
      "focus-chrome.js",
      "focus-cursor.js",
      "permission-handler.js",
      "browser-view.js",
      "browser-control.js",
      "browser-ops.js",
      "browser-annotate.js",
      "browser-agent-channel.js",
      "external-scheme.js",
      "validation.js",
      "context-menu.js",
      "preload.js",
      "mochi/index.js",
      "mochi/petOverlays.js",
      "mochi/pet-preload.js",
      "mochi/panelWindow.js",
      "mochi/avatarWindow.js",
      "mochi/settingsWindow.js",
      "mochi/snipWindow.js",
      "mochi/shortcuts.js",
      "mochi/pageUrl.js",
      "mochi/instanceGate.js",
      "mochi/machineStore.js",
      "crew-companion/index.js",
      "crew-companion/petOverlay.js",
      "crew-companion/pageUrl.js",
      "crew-companion/pet-preload.js",
      "crew-companion/panelWindow.js",
      "crew-companion/panelPlacement.js",
      "crew-companion/galleryWindow.js",
      "anime.global.js",
      "loading.html",
      "token-prompt.html",
      "icon.png",
      "icon-nightly.png",
      "trayTemplate.png",
      "trayTemplate@2x.png",
      "EXTERNALLY-MANAGED"
    ],
    "extraResources": [
      {
        "from": "backend-dist",
        "to": "backend-dist",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "build-info.json",
        "to": "build-info.json"
      }
    ],
    "publish": [],
    "win": {
      "icon": "icon.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true
    },
    "beforePack": "scripts/assert-bundled-backend.js"
  },
  "author": "EFM Leads"
}
